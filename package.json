{
  "name": "cfe-share-space",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,api -c cyan,magenta \"vite\" \"node --watch --env-file=.env server/index.js\"",
    "build": "vite build",
    "serve": "node --env-file=.env server/index.js",
    "start": "npm run build && npm run serve",
    "test:e2e": "npm run build && node --test --test-concurrency=1 e2e/*.test.js",
    "test:e2e:one": "npm run build && node --test --test-concurrency=1"
  },
  "dependencies": {
    "@preact/signals": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.2.4",
    "express": "^4.21.2",
    "marked": "^15.0.6",
    "preact": "^10.25.4",
    "preact-iso": "^2.9.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^9.1.2",
    "puppeteer": "^24.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
